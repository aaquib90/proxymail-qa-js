{
  "name": "proxymail-qa",
  "version": "0.8.1",
  "description": "Disposable test inboxes for Playwright, Cypress and scripts: create an address, then wait for its verification code or link.",
  "license": "MIT",
  "author": "Proxy Mail QA <hello@proxymail.qa> (https://proxymail.qa)",
  "homepage": "https://proxymail.qa/docs/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaquib90/proxymail-qa-js.git"
  },
  "bugs": {
    "url": "https://github.com/aaquib90/proxymail-qa-js/issues",
    "email": "hello@proxymail.qa"
  },
  "keywords": [
    "email testing",
    "otp",
    "magic link",
    "email verification",
    "playwright",
    "cypress",
    "qa"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./playwright/reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "default": "./dist/playwright-reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
