{
  "name": "proxymail-qa",
  "version": "0.12.0",
  "description": "Test every email your app sends from Playwright, Cypress, Jest, Vitest or any Node script: disposable inboxes, sign-up codes, links and coupons, email checks, unsubscribe tests and run reports.",
  "license": "MIT",
  "author": "Proxy Mail QA <hello@proxymail.qa> (https://proxymail.qa)",
  "homepage": "https://proxymail.qa/docs/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaquib90/proxymail-qa-js.git"
  },
  "bugs": {
    "url": "https://github.com/aaquib90/proxymail-qa-js/issues",
    "email": "hello@proxymail.qa"
  },
  "keywords": [
    "email testing",
    "otp",
    "magic link",
    "email verification",
    "playwright",
    "cypress",
    "puppeteer",
    "jest",
    "vitest",
    "e2e",
    "end-to-end testing",
    "email deliverability",
    "spf",
    "dkim",
    "test accounts",
    "coupon",
    "unsubscribe",
    "marketing email",
    "qa"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./playwright/reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "default": "./dist/playwright-reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
